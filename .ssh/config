Host *
  AddKeysToAgent yes
  UseKeychain yes
  IdentitiesOnly yes
  # Keep idle sessions to remote hosts alive
  ServerAliveInterval 60
  ServerAliveCountMax 3
  # Reuse one connection per host: repeat ssh/scp/git to the same host skip the handshake
  ControlMaster auto
  ControlPath ~/.ssh/sockets/%C
  ControlPersist 10m

Host github.com
  HostName github.com
  IdentityFile ~/.ssh/id_ed25519
